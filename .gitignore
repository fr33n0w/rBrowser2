# Your own data: never in the repository. rBrowser makes all of it on the
# first start (settings, identities and their private keys, LXMF chats,
# page cache, files received).
settings/
identities/
cache/
downloads/
nomadnet_browser_identity
*.pid

# The venv install.sh can make
.venv/

# Tools fetched at run time (cloudflared for the remote tunnel)
bin/

# Python and editor leftovers
__pycache__/
*.pyc
.pytest_cache/
*.bak
*.tmp
*.log
